generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Project {
  id                    String   @id @default(cuid())
  imageUrl              String
  ownerName             String?
  consultantName        String?
  projectContractorName String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}
